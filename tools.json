{
  "tools": [
    {
      "name": "subfinder",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/subfinder:v2.17.0",
      "args": ["-d", "{{host}}", "-json", "-o", "/out/subfinder.json", "-silent"],
      "outputFormat": "json",
      "outputType": "assets",
      "normalizer": "subfinder-json"
    },
    {
      "name": "dnsx",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/dnsx:v1.2.2",
      "args": ["-l", "{{hosts}}", "-json", "-o", "/out/dnsx.json", "-silent"],
      "outputFormat": "json",
      "outputType": "assets",
      "normalizer": "dnsx-json"
    },
    {
      "name": "alterx",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/alterx:v0.2.0",
      "args": ["-l", "{{hosts}}", "-o", "/out/alterx.txt"],
      "outputFormat": "text",
      "outputType": "assets",
      "normalizer": "alterx-text",
      "default": false
    },
    {
      "name": "httpx",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/httpx:v1.12.0",
      "args": ["-u", "{{target}}", "-json", "-o", "/out/httpx.json", "-title", "-tech-detect", "-status-code", "-silent"],
      "outputFormat": "json",
      "outputType": "assets",
      "normalizer": "httpx-json"
    },
    {
      "name": "katana",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/katana:v1.8.0",
      "args": ["-u", "{{target}}", "-jsonl", "-o", "/out/katana.jsonl", "-d", "{{depth}}", "-silent"],
      "outputFormat": "jsonl",
      "outputType": "assets",
      "normalizer": "katana-jsonl"
    },
    {
      "name": "naabu",
      "phase": "explore",
      "executor": "github",
      "image": "projectdiscovery/naabu:v2.3.3",
      "args": ["-host", "{{host}}", "-json", "-o", "/out/naabu.json", "-silent"],
      "outputFormat": "json",
      "outputType": "assets",
      "normalizer": "naabu-json",
      "default": false
    },
    {
      "name": "nuclei",
      "phase": "invasion",
      "executor": "github",
      "image": "projectdiscovery/nuclei:v3.11.1",
      "args": ["-u", "{{target}}", "-severity", "{{severity}}", "-sarif-export", "/out/nuclei.sarif", "-no-color"],
      "outputFormat": "sarif",
      "outputType": "findings",
      "normalizer": "nuclei-sarif"
    },
    {
      "name": "zap-baseline",
      "phase": "invasion",
      "executor": "github",
      "image": "ghcr.io/zaproxy/zaproxy:stable",
      "args": ["zap-baseline.py", "-t", "{{target}}", "-J", "/out/zap.json"],
      "outputFormat": "json",
      "outputType": "findings",
      "normalizer": "zap-json"
    }
  ]
}