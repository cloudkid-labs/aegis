---
// Static dashboard shell. All data comes from /api/* at runtime; nothing on
// this page is server-rendered from bindings, which is why the output is
// plain static HTML with no Astro adapter.
import "../styles/aegis.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1216" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Aegis: private recon and pentest console for allowlisted operators, running open-source tooling on Cloudflare Workers." />
    <title>Aegis: recon and pentest</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
      <div class="brand">
        <h1>Aegis</h1>
      </div>
      <nav id="session-nav" aria-label="Account">
        <a id="signin-link" class="button-link" href="/auth/google/start" hidden>Sign in with Google</a>
        <span id="session-email" hidden></span>
        <a id="signout-link" class="button-link secondary" href="/auth/logout" hidden>Sign out</a>
      </nav>
    </header>
    <main id="main-content">
      <section id="signin-notice" hidden>
        <div class="hero-grid">
          <div class="notice-copy">
            <h2>Know the surface. Then test it.</h2>
            <p class="notice-lede">Aegis orchestrates open-source recon and pentest tooling on Cloudflare Workers. Access is allowlisted.</p>
            <ul class="notice-phases">
              <li>Explore — subdomains, live hosts, endpoints.</li>
              <li>Invasion — nuclei and ZAP findings, severity-ranked.</li>
            </ul>
            <p class="notice-hint">Use Sign in with Google at the top of the page.</p>
          </div>
          <svg class="recon-graph" aria-hidden="true" focusable="false" viewBox="0 0 520 360" width="100%" height="auto">
            <g class="recon-edges">
              <line class="recon-edge" x1="260" y1="176" x2="96" y2="88" />
              <line class="recon-edge" x1="260" y1="176" x2="276" y2="46" />
              <line class="recon-edge" x1="260" y1="176" x2="438" y2="120" />
              <line class="recon-edge" x1="260" y1="176" x2="410" y2="272" />
              <line class="recon-edge" x1="260" y1="176" x2="228" y2="312" />
              <line class="recon-edge" x1="260" y1="176" x2="74" y2="240" />
            </g>
            <g class="recon-target">
              <circle class="recon-target-halo" cx="260" cy="176" r="44" />
              <circle class="recon-target-ring" cx="260" cy="176" r="24" />
              <circle class="recon-target-core" cx="260" cy="176" r="9" />
            </g>
            <g class="recon-node recon-node-1">
              <circle class="recon-node-ring" cx="96" cy="88" r="15" />
              <circle class="recon-node-dot" cx="96" cy="88" r="5" />
            </g>
            <g class="recon-node recon-node-2">
              <circle class="recon-node-ring" cx="276" cy="46" r="15" />
              <circle class="recon-node-dot" cx="276" cy="46" r="5" />
            </g>
            <g class="recon-node recon-node-3">
              <circle class="recon-node-ring" cx="438" cy="120" r="15" />
              <circle class="recon-node-dot" cx="438" cy="120" r="5" />
            </g>
            <g class="recon-node recon-node-4">
              <circle class="recon-node-ring" cx="410" cy="272" r="15" />
              <circle class="recon-node-dot" cx="410" cy="272" r="5" />
            </g>
            <g class="recon-node recon-node-5">
              <circle class="recon-node-ring" cx="228" cy="312" r="15" />
              <circle class="recon-node-dot" cx="228" cy="312" r="5" />
            </g>
            <g class="recon-node recon-node-6">
              <circle class="recon-node-ring" cx="74" cy="240" r="15" />
              <circle class="recon-node-dot" cx="74" cy="240" r="5" />
            </g>
            <g class="recon-sweep">
              <rect class="recon-sweep-glow" x="-7" y="6" width="14" height="348" />
              <rect class="recon-sweep-bar" x="-1" y="6" width="2" height="348" />
            </g>
            <g class="recon-chip recon-chip-high">
              <rect class="recon-chip-bg" x="392" y="48" width="56" height="22" rx="11" />
              <text class="recon-chip-label" x="420" y="63" text-anchor="middle">high</text>
            </g>
            <g class="recon-chip recon-chip-medium">
              <rect class="recon-chip-bg" x="426" y="296" width="64" height="22" rx="11" />
              <text class="recon-chip-label" x="458" y="311" text-anchor="middle">medium</text>
            </g>
            <g class="recon-chip recon-chip-low">
              <rect class="recon-chip-bg" x="36" y="40" width="50" height="22" rx="11" />
              <text class="recon-chip-label" x="61" y="55" text-anchor="middle">low</text>
            </g>
          </svg>
        </div>
        <div class="landing-strip" id="landing-pipeline">
          <h3>The pipeline</h3>
          <ol class="pipeline-steps">
            <li>
              <span class="step-num">1</span>
              <p class="step-title">Point it at a target.</p>
              <p class="step-body">Explore runs subfinder, dnsx, httpx and katana on GitHub Actions and stores what they find.</p>
            </li>
            <li>
              <span class="step-num">2</span>
              <p class="step-title">Choose what to test.</p>
              <p class="step-body">Invasion pre-selects the live URLs from an Explore run; you edit the list and confirm before anything runs.</p>
            </li>
            <li>
              <span class="step-num">3</span>
              <p class="step-title">Read ranked findings.</p>
              <p class="step-body">Severity, evidence, remediation and a SARIF export per scan.</p>
            </li>
          </ol>
          <p class="strip-note">Explore and Invasion are live; Reporting lands in Phase 3.</p>
        </div>
        <div class="landing-strip" id="landing-tooling">
          <h3>Open tooling</h3>
          <ul class="tool-roster">
            <li><a href="https://github.com/projectdiscovery/subfinder">subfinder</a> <span class="tool-role">subdomain enumeration</span></li>
            <li><a href="https://github.com/projectdiscovery/dnsx">dnsx</a> <span class="tool-role">DNS resolution</span></li>
            <li><a href="https://github.com/projectdiscovery/httpx">httpx</a> <span class="tool-role">live host probing</span></li>
            <li><a href="https://github.com/projectdiscovery/katana">katana</a> <span class="tool-role">crawling</span></li>
            <li><a href="https://github.com/projectdiscovery/naabu">naabu</a> <span class="tool-role">port scanning (opt-in)</span></li>
            <li><a href="https://github.com/projectdiscovery/alterx">alterx</a> <span class="tool-role">subdomain permutations (opt-in)</span></li>
            <li><a href="https://github.com/projectdiscovery/nuclei">nuclei</a> <span class="tool-role">template-based probes</span></li>
            <li><a href="https://www.zaproxy.org/">ZAP</a> <span class="tool-role">baseline and full scans</span></li>
          </ul>
          <p class="strip-note">Aegis orchestrates these; it adds no attack rules of its own.</p>
        </div>
        <div class="landing-strip" id="landing-privacy">
          <h3>Private by default</h3>
          <p class="notice-lede">Sign-in is allowlisted to named Google accounts. All authorized operators share one scan history; nothing is published outside this deployment.</p>
        </div>
      </section>
      <section id="create-section">
        <h2>New explore scan</h2>
        <form id="create-form">
          <div class="field field-target">
            <label class="field-label" for="target">Target</label>
            <input
              id="target"
              type="url"
              placeholder="https://target.example"
              required
            />
          </div>
          <div class="field field-depth">
            <label class="field-label" for="depth">Depth</label>
            <input id="depth" type="number" value="2" min="1" max="5" />
          </div>
          <div class="field field-submit">
            <button type="submit">Start explore</button>
          </div>
          <fieldset id="tool-toggles">
            <legend>Tools</legend>
            <label><input type="checkbox" name="tool" value="subfinder" checked /> subfinder</label>
            <label><input type="checkbox" name="tool" value="dnsx" checked /> dnsx</label>
            <label><input type="checkbox" name="tool" value="httpx" checked /> httpx</label>
            <label><input type="checkbox" name="tool" value="katana" checked /> katana</label>
            <label><input type="checkbox" name="tool" value="naabu" /> naabu</label>
            <label><input type="checkbox" name="tool" value="alterx" /> alterx</label>
            <span class="opt-in-note">naabu and alterx are opt-in: active port scan and subdomain permutation.</span>
          </fieldset>
        </form>
        <p id="create-status" role="status"></p>
      </section>
      <section id="list-section">
        <h2>History</h2>
        <div id="filters" role="group" aria-label="History filters">
          <input id="scan-search" type="search" placeholder="Search scans" aria-label="Search scans" autocomplete="off" />
          <select id="filter-phase" aria-label="Filter by phase">
            <option value="">All phases</option>
            <option value="explore">Explore</option>
            <option value="invasion">Invasion</option>
          </select>
          <select id="filter-status" aria-label="Filter by status">
            <option value="">All statuses</option>
            <option value="completed">Completed</option>
            <option value="running">Running</option>
            <option value="failed">Failed</option>
          </select>
        </div>
        <div class="table-wrap">
          <table id="scans-table">
            <thead>
              <tr>
                <th scope="col">ID</th><th scope="col">Target</th><th scope="col">Phase</th><th scope="col">Status</th><th scope="col">Assets</th><th scope="col">Created</th><th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
      <section id="detail-section" hidden>
        <h2 id="detail-title">Scan</h2>
        <div class="actions">
          <button id="back-btn">Back</button>
          <button id="retry-btn" hidden>Re-run</button>
          <button id="invade-btn" disabled title="Invasion needs a completed explore scan">Invoke invasion</button>
        </div>
        <div id="detail-meta"></div>
        <h3>Discovered assets</h3>
        <div class="detail-toolbar">
          <input id="asset-search" type="search" placeholder="Search assets" aria-label="Search assets" autocomplete="off" />
          <p id="asset-count" role="status"></p>
        </div>
        <div class="table-wrap">
          <table id="assets-table">
            <thead>
              <tr><th scope="col">Type</th><th scope="col">Value</th><th scope="col">Metadata</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <!-- A block, not a <section>: the global section rule is the glass
             panel chrome, and this block lives inside the detail panel. -->
        <div id="findings-section" hidden>
          <h3>Findings</h3>
          <div class="detail-toolbar">
            <select id="finding-severity" aria-label="Filter findings by severity">
              <option value="">All severities</option>
              <option value="critical">Critical</option>
              <option value="high">High</option>
              <option value="medium">Medium</option>
              <option value="low">Low</option>
              <option value="info">Info</option>
            </select>
            <select id="finding-tool" aria-label="Filter findings by tool">
              <option value="">All tools</option>
            </select>
            <input id="finding-search" type="search" placeholder="Search findings" aria-label="Search findings" autocomplete="off" />
            <p id="finding-count" role="status"></p>
          </div>
          <div class="table-wrap">
            <table id="findings-table">
              <thead>
                <tr><th scope="col">Severity</th><th scope="col">Tool</th><th scope="col">Title</th><th scope="col">URL</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </section>
      <section id="invasion-confirm" hidden>
        <h2>Invasion scan</h2>
        <p id="invasion-summary" class="strip-note"></p>
        <h3>Targets</h3>
        <div id="invasion-targets" class="target-list" role="group" aria-label="Invasion target URLs"></div>
        <h3>Tools</h3>
        <fieldset id="invasion-tools">
          <legend>Tools</legend>
          <label><input type="checkbox" name="invasion-tool" value="nuclei" checked /> nuclei</label>
          <label><input type="checkbox" name="invasion-tool" value="zap-baseline" checked /> zap-baseline</label>
          <label><input type="checkbox" name="invasion-tool" value="zap-full" /> zap-full</label>
        </fieldset>
        <p id="invasion-active-note" class="invasion-warning" hidden>Active attack scanning: zap-full sends attack payloads at every selected URL. Expect up to 60 minutes.</p>
        <div class="invasion-field">
          <label class="field-label" for="invasion-severity">Nuclei severity filter</label>
          <select id="invasion-severity">
            <option value="critical,high,medium">Critical, high, medium (default)</option>
            <option value="critical,high">Critical and high</option>
            <option value="critical">Critical only</option>
            <option value="critical,high,medium,low">Critical through low</option>
            <option value="critical,high,medium,low,info">All severities</option>
          </select>
        </div>
        <p class="strip-note">Confirming starts the scan immediately; this exact selection is stored with it. ZAP reports every risk it finds.</p>
        <div class="actions">
          <button id="invasion-confirm-btn">Confirm invasion</button>
          <button id="invasion-cancel-btn" class="secondary">Cancel</button>
        </div>
        <p id="invasion-status" role="status"></p>
      </section>
    </main>
    <footer>
      <span>Aegis</span>
      <span>OSS recon &amp; pentest</span>
      <span>Runs on Cloudflare Workers</span>
    </footer>

    <script>
      // Dashboard client. Everything rendered here came from /api/*, so it is
      // built with createElement/textContent only — no innerHTML, ever.
      // The same-origin session cookie authenticates the API; no key is stored
      // client side. Headless automation uses the Bearer API key server-side.
      import { matchesQuery } from "../client/search";

      async function api(path, opts = {}) {
        const res = await fetch(path, { ...opts, headers: { "content-type": "application/json", ...(opts.headers || {}) } });
        if (!res.ok) throw new Error(`${res.status}: ${await res.text()}`);
        return res.status === 204 ? null : res.json();
      }

      function el(tag, text, attrs = {}) {
        const node = document.createElement(tag);
        if (text !== undefined && text !== null) node.textContent = String(text);
        for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
        return node;
      }
      function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); }

      // Keyed row cache + change signature: the 5s poll must not repaint the
      // table when nothing changed, and must not recreate rows (which drops
      // focus and flickers) when something did. Cells are updated in place;
      // the Cancel button is rebuilt only when a scan's status flips.
      const scanRows = new Map();
      let lastSig = null;
      let placeholder = null;
      let detailId = null;
      // Search filters what is already loaded, so typing never refetches: the
      // last response is kept and re-filtered by renderScans/renderAssets.
      let scanCache = [];
      let scanError = null;
      let detailAssets = [];
      let lastAssetSig = null;
      // Findings belong to one loaded invasion scan. The count the operator
      // sees is derived from this endpoint payload, never from callback event
      // text (a callback counts normalized findings, not unique rows).
      let detailScan = null;
      let detailFindings = [];
      let findingsError = null;
      const expandedFindings = new Set();

      function setText(td, text) {
        const s = String(text);
        if (td.textContent !== s) td.textContent = s;
      }
      function fillRow(row, s) {
        setText(row.tds[0], s.id.slice(0, 8));
        setText(row.tds[1], s.target);
        setText(row.tds[2], s.phase);
        setText(row.tds[3], s.status);
        const cls = `status-${s.status}`;
        if (row.tds[3].className !== cls) row.tds[3].className = cls;
        setText(row.tds[4], s.assetCount ?? "—");
        setText(row.tds[5], s.createdAt.slice(0, 16).replace("T", " "));
        if (row.status !== s.status) {
          if (row.cancel) { row.cancel.remove(); row.cancel = null; }
          if (row.rerun) { row.rerun.remove(); row.rerun = null; }
          if (s.status === "queued" || s.status === "running") {
            const cancel = el("button", "Cancel");
            cancel.addEventListener("click", async () => { await api(`/api/scans/${s.id}/cancel`, { method: "POST" }); loadScans(true); });
            row.actions.append(cancel);
            row.cancel = cancel;
          }
          if (s.status === "failed" || s.status === "cancelled") {
            const rerun = el("button", "Re-run");
            rerun.addEventListener("click", async () => {
              const { id } = await api(`/api/scans/${s.id}/retry`, { method: "POST" });
              loadScans(true);
              showDetail(id);
            });
            row.actions.append(rerun);
            row.rerun = rerun;
          }
          row.status = s.status;
        }
      }
      function buildRow(s) {
        const tr = el("tr");
        const tds = [el("td"), el("td"), el("td"), el("td"), el("td"), el("td")];
        const actions = el("td");
        const view = el("button", "View");
        view.addEventListener("click", () => showDetail(s.id));
        actions.append(view);
        tr.append(...tds, actions);
        const row = { tr, tds, actions, cancel: null, rerun: null, status: null };
        fillRow(row, s);
        return row;
      }
      function showPlaceholder(tbody, text) {
        if (!placeholder) {
          placeholder = el("tr");
          placeholder.append(el("td", "", { colspan: "7" }));
        }
        setText(placeholder.firstChild, text);
        if (placeholder.parentNode !== tbody) tbody.append(placeholder);
      }
      function hidePlaceholder() {
        if (placeholder && placeholder.parentNode) placeholder.remove();
      }

      async function loadScans(force = false) {
        try {
          const { scans } = await api("/api/scans");
          scanCache = scans;
          scanError = null;
        } catch (err) { scanError = String(err.message); }
        renderScans(force);
      }

      function renderScans(force = false) {
        const phaseFilter = document.querySelector("#filter-phase").value;
        const statusFilter = document.querySelector("#filter-status").value;
        const query = document.querySelector("#scan-search").value;
        const list = scanError ? [] : scanCache.filter((s) =>
          (!phaseFilter || s.phase === phaseFilter) &&
          (!statusFilter || s.status === statusFilter) &&
          matchesQuery(query, [s.target, s.id, s.phase, s.status]));

        const sig = JSON.stringify([phaseFilter, statusFilter, query, scanError, list.map((s) => [s.id, s.target, s.phase, s.status, s.assetCount ?? null, s.createdAt])]);
        if (!force && sig === lastSig) return; // unchanged: no DOM writes at all
        lastSig = sig;

        const tbody = document.querySelector("#scans-table tbody");
        if (scanError || list.length === 0) {
          for (const [, row] of scanRows) row.tr.remove();
          scanRows.clear();
          const empty = query.trim() ? `No scans match "${query.trim()}".` : "No scans yet.";
          showPlaceholder(tbody, scanError || empty);
          return;
        }
        hidePlaceholder();
        const seen = new Set();
        let prev = null;
        for (const s of list) {
          seen.add(s.id);
          let row = scanRows.get(s.id);
          if (!row) { row = buildRow(s); scanRows.set(s.id, row); }
          else fillRow(row, s);
          const ref = prev ? prev.nextSibling : tbody.firstChild;
          if (ref !== row.tr) tbody.insertBefore(row.tr, ref);
          prev = row.tr;
        }
        for (const [id, row] of scanRows) {
          if (!seen.has(id)) { row.tr.remove(); scanRows.delete(id); }
        }
      }

      async function showDetail(id) {
        if (detailId !== id) {
          document.querySelector("#asset-search").value = "";
          document.querySelector("#finding-search").value = "";
          document.querySelector("#finding-severity").value = "";
        }
        detailId = id;
        expandedFindings.clear();
        document.querySelector("#invasion-confirm").hidden = true;
        document.querySelector("#list-section").hidden = true;
        document.querySelector("#create-section").hidden = true;
        const detail = document.querySelector("#detail-section");
        detail.hidden = false;
        document.querySelector("#detail-title").textContent = `Scan ${id.slice(0, 8)}`;
        // Until this scan's metadata lands, the panel must not act on the
        // previous one: Invade would chain off the old scan and retry would
        // re-run it. Clear the context synchronously, before the first await.
        detailScan = null;
        detailFindings = [];
        findingsError = null;
        detailAssets = [];
        lastAssetSig = null;
        renderAssets();
        document.querySelector("#invade-btn").disabled = true;
        document.querySelector("#retry-btn").hidden = true;
        document.querySelector("#findings-section").hidden = true;
        const { scan, events } = await api(`/api/scans/${id}`);
        // Every await below can outlive the view: fast View-A → Back → View-B
        // leaves A's late response landing on B's panel (title says B, meta and
        // assets say A, and Invade would chain a new scan off parent A). Each
        // response is only applied while its id is still the one on screen.
        if (detailId !== id) return;
        detailScan = scan;
        document.querySelector("#retry-btn").hidden = !(scan.status === "failed" || scan.status === "cancelled");
        // An invasion chains off exactly one thing: a completed explore scan.
        const invade = document.querySelector("#invade-btn");
        const canInvade = scan.phase === "explore" && scan.status === "completed";
        invade.disabled = !canInvade;
        invade.title = canInvade
          ? "Pick this scan's live URLs and confirm the tools"
          : "Invasion needs a completed explore scan";
        const meta = document.querySelector("#detail-meta");
        clear(meta);
        meta.append(el("p", `${scan.target} | ${scan.phase} | ${scan.status} | ${scan.createdAt}`));
        for (const ev of events || []) meta.append(el("p", `${ev.createdAt} — ${ev.event}${ev.detail ? ": " + ev.detail : ""}`));
        const { assets } = await api(`/api/scans/${id}/assets`);
        if (detailId !== id) return;
        detailAssets = assets;
        lastAssetSig = null;
        renderAssets();

        document.querySelector("#findings-section").hidden = scan.phase !== "invasion";
        detailFindings = [];
        findingsError = null;
        if (scan.phase === "invasion") {
          try {
            const { findings } = await api(`/api/scans/${id}/findings`);
            if (detailId !== id) return;
            detailFindings = sortFindings(findings);
          } catch (err) {
            // A rejection is the same race: A's late failure must not paint an
            // error over B's table.
            if (detailId !== id) return;
            findingsError = String(err.message);
          }
          buildToolFilter();
        }
        renderFindings();
      }

      function assetMeta(a) {
        if (!a.metadata) return "";
        try {
          const m = JSON.parse(a.metadata);
          return Object.entries(m).filter(([, v]) => v != null).map(([k, v]) => `${k}: ${Array.isArray(v) ? v.join(", ") : v}`).join(" | ");
        } catch { return ""; }
      }

      function renderAssets() {
        const query = document.querySelector("#asset-search").value;
        // Match the metadata as rendered, so searching "200" or a tech name
        // finds the row the operator can actually see.
        const rows = detailAssets
          .map((a) => ({ asset: a, meta: assetMeta(a) }))
          .filter(({ asset, meta }) => matchesQuery(query, [asset.type, asset.value, meta]));
        const sig = JSON.stringify([query, rows.map(({ asset }) => asset.id)]);
        if (sig === lastAssetSig) return;
        lastAssetSig = sig;

        const tbody = document.querySelector("#assets-table tbody");
        clear(tbody);
        for (const { asset, meta } of rows) {
          const tr = el("tr");
          tr.append(el("td", asset.type), el("td", asset.value), el("td", meta));
          tbody.append(tr);
        }
        if (rows.length === 0) {
          const tr = el("tr");
          tr.append(el("td", detailAssets.length === 0 ? "No assets discovered." : "No assets match.", { colspan: "3" }));
          tbody.append(tr);
        }
        document.querySelector("#asset-count").textContent =
          detailAssets.length === 0 ? "" : `${rows.length} of ${detailAssets.length} assets`;
      }

      // Findings: server order is severity rank then discovery time; sorting
      // here too keeps the table meaningful even if a stored row predates it.
      const SEVERITY_ORDER = ["critical", "high", "medium", "low", "info"];
      function severityRank(severity) {
        const rank = SEVERITY_ORDER.indexOf(severity);
        return rank === -1 ? SEVERITY_ORDER.length : rank;
      }
      function sortFindings(findings) {
        return [...findings].sort((a, b) =>
          severityRank(a.severity) - severityRank(b.severity)
          || String(a.createdAt).localeCompare(String(b.createdAt))
          || String(a.id).localeCompare(String(b.id)));
      }

      function buildToolFilter() {
        const select = document.querySelector("#finding-tool");
        clear(select);
        select.append(el("option", "All tools", { value: "" }));
        for (const tool of [...new Set(detailFindings.map((f) => f.tool))].sort()) {
          select.append(el("option", tool, { value: tool }));
        }
        select.value = "";
      }

      function findingDetail(f) {
        const tr = el("tr", null, { class: "finding-detail", id: `finding-detail-${f.id}` });
        const cell = el("td", null, { colspan: "4" });
        const list = el("dl", null, { class: "finding-detail-list" });
        const fields = [
          ["Description", f.description],
          ["Evidence", f.evidence],
          ["Remediation", f.remediation],
          ["CWE", f.cwe == null ? null : `CWE-${f.cwe}`],
          ["Raw artifact", f.rawRef],
        ];
        for (const [label, value] of fields) {
          // Every value is rendered with textContent (see el); tool output is
          // never markup.
          if (value == null || String(value).trim() === "") continue;
          list.append(el("dt", label), el("dd", value));
        }
        if (!list.firstChild) list.append(el("dt", "Details"), el("dd", "No further detail recorded."));
        cell.append(list);
        tr.append(cell);
        return tr;
      }

      function toggleFinding(f, detail, button) {
        const open = !expandedFindings.has(f.id);
        if (open) expandedFindings.add(f.id);
        else expandedFindings.delete(f.id);
        // The detail row stays in the DOM so aria-controls always resolves;
        // [hidden] keeps it out of layout and the accessibility tree.
        detail.hidden = !open;
        button.setAttribute("aria-expanded", String(open));
      }

      function findingRow(f) {
        const tr = el("tr", null, { class: "finding-row" });
        const severityCell = el("td");
        severityCell.append(el("span", f.severity, { class: `severity-chip severity-${f.severity}` }));
        const titleCell = el("td");
        const button = el("button", f.title || "Untitled finding", {
          class: "finding-title", type: "button",
          "aria-expanded": "false",
          "aria-controls": `finding-detail-${f.id}`,
        });
        titleCell.append(button);
        tr.append(severityCell, el("td", f.tool), titleCell, el("td", f.url));
        const detail = findingDetail(f);
        // The row click is the brief's affordance; the title button is the
        // keyboard path. stopPropagation keeps one click from toggling twice.
        button.addEventListener("click", (event) => {
          event.stopPropagation();
          toggleFinding(f, detail, button);
        });
        tr.addEventListener("click", () => toggleFinding(f, detail, button));
        return { tr, detail, button };
      }

      function renderFindings() {
        const severity = document.querySelector("#finding-severity").value;
        const tool = document.querySelector("#finding-tool").value;
        const query = document.querySelector("#finding-search").value;
        const rows = detailFindings.filter((f) =>
          (!severity || f.severity === severity)
          && (!tool || f.tool === tool)
          && matchesQuery(query, [f.title, f.url, f.tool, f.evidence]));

        const tbody = document.querySelector("#findings-table tbody");
        clear(tbody);
        for (const finding of rows) {
          const { tr, detail, button } = findingRow(finding);
          const open = expandedFindings.has(finding.id);
          detail.hidden = !open;
          button.setAttribute("aria-expanded", String(open));
          tbody.append(tr, detail);
        }
        if (rows.length === 0) {
          const tr = el("tr");
          const text = findingsError
            ? `Could not load findings: ${findingsError}`
            : detailFindings.length === 0 ? "No findings recorded." : "No findings match.";
          tr.append(el("td", text, { colspan: "4" }));
          tbody.append(tr);
        }
        document.querySelector("#finding-count").textContent = detailFindings.length === 0
          ? ""
          : `${rows.length} of ${detailFindings.length} findings`;
      }

      // Invasion confirm. The preview is the server's own selection, so the
      // checkboxes and the payload can never drift from the server's subset
      // check; excluded URLs are shown with their reason and stay unticked.
      let invasionParentId = null;

      function renderInvasionTargets(preview) {
        const box = document.querySelector("#invasion-targets");
        clear(box);
        for (const target of preview.targets) {
          const label = el("label", null, { class: "target-choice" });
          const check = el("input", null, { type: "checkbox", name: "invasion-target", value: target.url });
          check.checked = true;
          label.append(
            check,
            el("span", target.url, { class: "target-url" }),
            el("span", `${target.type} | ${target.statusCode}`, { class: "target-meta" }),
          );
          box.append(label);
        }
        for (const excluded of preview.excluded) {
          const label = el("label", null, { class: "target-choice excluded" });
          const check = el("input", null, { type: "checkbox", name: "invasion-target", value: excluded.url });
          check.disabled = true;
          label.append(
            check,
            el("span", excluded.url, { class: "target-url" }),
            el("span", excluded.reason, { class: "target-reason" }),
          );
          box.append(label);
        }
        if (preview.targets.length === 0 && preview.excluded.length === 0) {
          box.append(el("p", "No URLs discovered by this scan.", { class: "target-meta" }));
        }
        document.querySelector("#invasion-summary").textContent =
          `${preview.targets.length} live URL${preview.targets.length === 1 ? "" : "s"} kept, `
          + `${preview.excluded.length} excluded; at most ${preview.maxUrls} per invasion scan.`;
      }

      async function openInvasionConfirm() {
        if (!detailScan || detailScan.phase !== "explore" || detailScan.status !== "completed") return;
        // The panel can be cancelled and reopened for another scan while the
        // preview is in flight; that response belongs to the panel that asked,
        // not the one now on screen.
        const parentId = detailScan.id;
        invasionParentId = parentId;
        const status = document.querySelector("#invasion-status");
        const confirmBtn = document.querySelector("#invasion-confirm-btn");
        clear(document.querySelector("#invasion-targets"));
        document.querySelector("#invasion-summary").textContent = "";
        document.querySelector("#invasion-active-note").hidden = true;
        document.querySelector("#invasion-severity").value = "critical,high,medium";
        for (const box of document.querySelectorAll('input[name="invasion-tool"]')) {
          box.checked = box.value !== "zap-full";
        }
        confirmBtn.disabled = true;
        status.textContent = "Loading this scan's live URLs…";
        document.querySelector("#detail-section").hidden = true;
        document.querySelector("#invasion-confirm").hidden = false;
        try {
          const preview = await api(`/api/scans/${parentId}/invasion-preview`);
          if (invasionParentId !== parentId || document.querySelector("#invasion-confirm").hidden) return;
          renderInvasionTargets(preview);
          status.textContent = preview.targets.length === 0
            ? "This scan has no live URLs left to attack. Run a new explore scan first."
            : "";
          confirmBtn.disabled = preview.targets.length === 0;
        } catch (err) {
          if (invasionParentId !== parentId || document.querySelector("#invasion-confirm").hidden) return;
          status.textContent = `Could not load the preview: ${err.message}`;
        }
      }

      async function bootstrap() {
        let me = { authenticated: false };
        try { me = await api("/auth/me"); } catch {}
        const signedIn = !!me.authenticated;
        document.querySelector("#signin-link").hidden = signedIn;
        document.querySelector("#signout-link").hidden = !signedIn;
        const email = document.querySelector("#session-email");
        email.hidden = !signedIn;
        if (signedIn) email.textContent = me.email || "";
        document.querySelector("#signin-notice").hidden = signedIn;
        document.querySelector("#create-section").hidden = !signedIn;
        document.querySelector("#list-section").hidden = !signedIn;
        if (signedIn) loadScans();
      }

      document.querySelector("#create-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const status = document.querySelector("#create-status");
        status.textContent = "Starting…";
        const tools = [...document.querySelectorAll('input[name="tool"]:checked')].map((c) => c.value);
        try {
          const body = { target: document.querySelector("#target").value, phase: "explore", options: { depth: Number(document.querySelector("#depth").value), tools } };
          const { id } = await api("/api/scans", { method: "POST", body: JSON.stringify(body) });
          status.textContent = `Started ${id.slice(0, 8)}`;
          loadScans();
        } catch (err) { status.textContent = `Error: ${err.message}`; }
      });

      document.querySelector("#retry-btn").addEventListener("click", async () => {
        if (!detailId) return;
        const btn = document.querySelector("#retry-btn");
        btn.disabled = true;
        try {
          const { id } = await api(`/api/scans/${detailId}/retry`, { method: "POST" });
          loadScans(true);
          showDetail(id);
        } finally { btn.disabled = false; }
      });

      document.querySelector("#back-btn").addEventListener("click", () => {
        document.querySelector("#detail-section").hidden = true;
        document.querySelector("#list-section").hidden = false;
        document.querySelector("#create-section").hidden = false;
        loadScans();
      });

      document.querySelector("#filter-phase").addEventListener("change", () => loadScans(true));
      document.querySelector("#filter-status").addEventListener("change", () => loadScans(true));
      document.querySelector("#scan-search").addEventListener("input", () => renderScans(true));
      document.querySelector("#asset-search").addEventListener("input", renderAssets);
      document.querySelector("#finding-severity").addEventListener("change", renderFindings);
      document.querySelector("#finding-tool").addEventListener("change", renderFindings);
      document.querySelector("#finding-search").addEventListener("input", renderFindings);

      document.querySelector("#invade-btn").addEventListener("click", openInvasionConfirm);
      document.querySelector("#invasion-cancel-btn").addEventListener("click", () => {
        document.querySelector("#invasion-confirm").hidden = true;
        document.querySelector("#detail-section").hidden = false;
      });
      const zapFull = document.querySelector('input[name="invasion-tool"][value="zap-full"]');
      zapFull.addEventListener("change", () => {
        document.querySelector("#invasion-active-note").hidden = !zapFull.checked;
      });
      document.querySelector("#invasion-confirm-btn").addEventListener("click", async () => {
        const status = document.querySelector("#invasion-status");
        const btn = document.querySelector("#invasion-confirm-btn");
        const targets = [...document.querySelectorAll('input[name="invasion-target"]:checked')].map((box) => box.value);
        const tools = [...document.querySelectorAll('input[name="invasion-tool"]:checked')].map((box) => box.value);
        if (targets.length === 0 || tools.length === 0) {
          status.textContent = "Select at least one target and one tool.";
          return;
        }
        btn.disabled = true;
        status.textContent = "Starting…";
        try {
          // Section 1 create payload verbatim; the server validates the subset,
          // caps, tools and the confirmed flag before anything is dispatched.
          const body = {
            phase: "invasion",
            parentScanId: invasionParentId,
            targets,
            tools,
            options: { severity: document.querySelector("#invasion-severity").value },
            authorization: { confirmed: true },
          };
          const { id } = await api("/api/scans", { method: "POST", body: JSON.stringify(body) });
          document.querySelector("#invasion-confirm").hidden = true;
          status.textContent = "";
          loadScans(true);
          showDetail(id);
        } catch (err) {
          status.textContent = `Could not start the invasion: ${err.message}`;
        } finally { btn.disabled = false; }
      });
      bootstrap();
      // Poll only while the list is on screen and the tab is visible; a hidden
      // tab must not keep fetching and repainting in the background.
      setInterval(() => {
        if (document.hidden) return;
        if (!document.querySelector("#list-section").hidden) loadScans();
      }, 5000);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && !document.querySelector("#list-section").hidden) loadScans();
      });
    </script>
  </body>
</html>